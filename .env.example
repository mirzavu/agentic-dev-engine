# OpenHands SDK subscription authentication is supplied by LLM.subscription_login,
# not by mounting your home directory or printing an API key.
# AUTODEV_OPENHANDS_AGENT_KIND=agent
# AUTODEV_CODEX_MODEL=gpt-5.5

# Optional experiment-only fallback paths. Leave off for intended OpenHands-only runs.
# AUTODEV_CODEX_CLI_FALLBACK=false
# AUTODEV_OPENHANDS_AGENT_KIND=acp
# AUTODEV_CODEX_AUTH_PATH=/home/you/.codex/auth.json

# Conservative live-run limits (optional)
# AUTODEV_MAX_REPAIRS=2
# AUTODEV_MAX_ITERATIONS=75
# AUTODEV_WALL_CLOCK_SECONDS=2700
# AUTODEV_MODEL_TIMEOUT_SECONDS=120
# AUTODEV_COMMAND_TIMEOUT_SECONDS=600
# AUTODEV_VISUAL_REVIEW_SECONDS=360
# AUTODEV_VISUAL_MAX_ROUNDS=3
# AUTODEV_VISUAL_SCORE_THRESHOLD=8
